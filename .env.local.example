# ==============================================================================
# BUYMO C2C — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase — Project Settings > API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=          # SupabaseプロジェクトURL (例: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # Anon/public key (ブラウザへの公開可)
SUPABASE_SERVICE_ROLE_KEY=         # Service role key (NEVER expose to browser; サーバ専用)

# ------------------------------------------------------------------------------
# Square Payments — Square Developer Dashboard (developer.squareup.com)
# サンドボックス環境で開発し、本番リリース時に production 値に差し替える
# Webhook URL: https://<your-domain>/api/square/webhook
# 購読イベント: payment.completed, payment.failed, refund.completed, refund.failed
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SQUARE_APPLICATION_ID= # Square Developer > Application ID (クライアント公開可)
NEXT_PUBLIC_SQUARE_LOCATION_ID=    # Square Developer > Location ID (クライアント公開可)
SQUARE_ACCESS_TOKEN=               # Square Developer > Access Token (サーバ専用・秘匿)
SQUARE_LOCATION_ID=                # NEXT_PUBLIC_SQUARE_LOCATION_ID と同じ値 (サーバ用)
SQUARE_ENVIRONMENT=sandbox         # "sandbox" (開発) または "production" (本番)
SQUARE_WEBHOOK_SIGNATURE_KEY=      # Square Developer > Webhooks > Signature Key

# ------------------------------------------------------------------------------
# Email (Resend) — resend.com
# 未設定時はメール送信をスキップしてデモ動作する
# ------------------------------------------------------------------------------
RESEND_API_KEY=                    # resend.com > API Keys で発行
EMAIL_FROM=                        # 送信者表示名とアドレス (例: "BUYMO C2C <noreply@yourdomain.com>")
OPS_EMAIL=                         # 運営管理者のメールアドレス (システム通知の宛先)

# ------------------------------------------------------------------------------
# Push Notifications (VAPID)
# 以下コマンドで生成:
#   npx web-push generate-vapid-keys
# または:
#   node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log(k)"
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=      # VAPID 公開鍵 (ブラウザへの公開可)
VAPID_PRIVATE_KEY=                 # VAPID 秘密鍵 (サーバ専用・秘匿)
VAPID_SUBJECT=                     # 連絡先URI (例: "mailto:admin@yourdomain.com")

# ------------------------------------------------------------------------------
# Site URL — 認証メールのリダイレクトや OG タグに使用
# ローカル開発: http://localhost:3000
# 本番: https://yourdomain.com
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=              # https://yourdomain.com

# ------------------------------------------------------------------------------
# Security
# openssl rand -hex 32 で生成したランダム文字列を設定する
# ------------------------------------------------------------------------------
ALERT_CRON_SECRET=                 # /api/alert-check 手動呼び出し用トークン
# CRON_SECRET=                     # Vercel Cron が自動設定 (ローカルテスト時のみ任意値を設定)

# ------------------------------------------------------------------------------
# OAuth — Supabase Dashboard → Authentication → Providers で設定
# 認証後のリダイレクト先として以下を Supabase の "Redirect URLs" に追加:
#   http://localhost:3000/auth/callback      (ローカル開発)
#   https://yourdomain.com/auth/callback    (本番)
# ------------------------------------------------------------------------------

# Google OAuth — https://console.cloud.google.com/ で OAuth クライアントを作成
# 取得した値を Supabase Dashboard > Auth > Providers > Google に入力（.env.local 不要）
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# LINE Login — LINE Developers Console (developers.line.biz) でチャネルを作成
# 取得した値を Supabase Dashboard > Auth > Providers > LINE に入力（.env.local 不要）
# Supabase コールバック URL: https://<project-ref>.supabase.co/auth/v1/callback
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret

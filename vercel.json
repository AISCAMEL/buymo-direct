{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "crons": [
    {
      "path": "/api/alert-check",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/models/refresh",
      "schedule": "0 3 * * 1"
    }
  ],
  "functions": {
    "app/api/webhooks/square/route.ts": { "maxDuration": 30 },
    "app/api/square/webhook/route.ts": { "maxDuration": 30 },
    "app/api/dealer/webhook/route.ts": { "maxDuration": 30 },
    "app/api/payment/create-link/route.ts": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" }
  ]
}
